{
  "name": "@xbibzlibrary/whatsbibz",
  "version": "1.4.4",
  "description": "WhatsBibz — WhatsApp Web multi-device library for Node.js (maintained Baileys fork): high-level client, custom pairing codes, self-healing sessions, configurable or automatic linked-device identity, complete TypeScript declarations.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./lib/*": "./lib/*",
    "./WAProto/*": "./WAProto/*"
  },
  "files": [
    "lib/**/*",
    "WAProto/index.js",
    "WAProto/index.d.ts",
    "WAProto/WAProto.proto",
    "LICENSE",
    "LICENSE.upstream",
    "README.md",
    "README.id.md",
    "CHANGELOG.md",
    "assets/logo/preview.png",
    "assets/logo/whatsbibz.ico",
    "assets/logo/png/icon-*.png",
    "assets/logo/png/mark-512.png",
    "assets/logo/png/banner-1200x360.png",
    "assets/logo/README.md",
    "VERIFIKASI-IDENTITAS-2026-09-03.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:live": "BIBZ_LIVE=1 node --test test/identity-live.test.js",
    "prepublishOnly": "npm test && node scripts/check.js",
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0"
  },
  "keywords": [
    "whatsbibz",
    "bibzwhats",
    "xbibz",
    "xbibzlibrary",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "whatsapp-web",
    "baileys",
    "multi-device",
    "pairing-code",
    "bot",
    "automation"
  ],
  "author": {
    "name": "Xbibz Developer",
    "email": "revandoppratama@gmail.com",
    "url": "https://github.com/XbibzOfficial777"
  },
  "license": "MIT",
  "homepage": "https://github.com/XbibzOfficial777/whatsbibz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XbibzOfficial777/whatsbibz.git"
  },
  "bugs": {
    "url": "https://github.com/XbibzOfficial777/whatsbibz/issues",
    "email": "revandoppratama@gmail.com"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.7.6",
    "@hapi/boom": "^9.1.4",
    "@types/ws": "^8.18.2",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.3",
    "libsignal": "^6.0.0",
    "long": "^5.3.2",
    "lru-cache": "^11.5.3",
    "music-metadata": "^11.16.1",
    "p-queue": "^9.3.5",
    "pino": "^9.14.0",
    "protobufjs": "^7.6.6",
    "whatsapp-rust-bridge": "0.5.5",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@roamhq/wrtc": "*",
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
